{
  "name": "hdm-whatsapp-bot",
  "version": "3.0.0",
  "description": "HDM BOT - Multi-Session WhatsApp Bot with REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "admin": "node scripts/admin.js",
    "install:all": "npm install && cd client && npm install",
    "build": "cd client && npm run build && cd ..",
    "build:start": "npm run build && npm start",
    "restart": "npm run build && npm start"
  },
  "keywords": ["whatsapp", "bot", "baileys", "hdm", "multi-session", "mongodb", "cloudinary", "redis"],
  "author": "Davix HDM",
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "form-data": "^4.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "nodemon": "^3.1.9"
  }
}